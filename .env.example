# ──────────────────────────────────────────────────────────────
# AmaraGo Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Firebase ──────────────────────────────────────────────────
# Absolute path to your Firebase service-account JSON key file
# OR paste the JSON directly as a compact single-line string.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Your Firebase project ID (visible in the Firebase console)
FIREBASE_PROJECT_ID=amarago-f0dc7

# ── App ───────────────────────────────────────────────────────
# Allowed CORS origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: server port (default 8000)
PORT=8000
